{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weatherman-madrid-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "AEMET_HOT",
      "id": "a6d21e1736244b4d8dffa296f6664aff"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "weatherman84",
    "GITHUB_REPO": "weatherman-madrid",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": [
      "50 * * * *",
      "7,37 5-20 * * *",
      "15 19,20 * * *"
    ]
  }
}
